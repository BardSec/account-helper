# ── Required ─────────────────────────────────────────────────────────────────
# LDAP server URL.
# Must use ldaps:// (port 636) — AD will reject password changes over plain LDAP.
AD_SERVER=ldaps://dc01.corp.com

# Base DN for the user search. Should cover all OUs where technicians' target accounts live.
AD_BASE_DN=DC=corp,DC=com

# ── Optional ──────────────────────────────────────────────────────────────────
# Flask session secret. Change this to a long random string in production.
SECRET_KEY=change-me-to-a-long-random-string

# Port the web server listens on (default: 5000).
# PORT=5000

# Set to "true" ONLY in dev/test environments using self-signed or internal-CA certificates.
# Leave "false" (or omit) in production.
# AD_SKIP_TLS_VERIFY=false
